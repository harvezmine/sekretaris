# ============================================================================
# Milo — salin ke .env lalu isi. File .env berisi rahasia: jangan di-commit.
# ============================================================================

# --- Docker Compose ---------------------------------------------------------
# Kata sandi Postgres internal. Buat acak, mis.: openssl rand -hex 24
POSTGRES_PASSWORD=
# Alamat publik: `tunnel` (Cloudflare Tunnel bernama, butuh TUNNEL_TOKEN & domain)
# atau `quicktunnel` (alamat trycloudflare sementara, tanpa akun). Kosongkan untuk uji lokal.
COMPOSE_PROFILES=
TUNNEL_TOKEN=
# Opsional: alamat publik tetap, dipakai untuk mencetak URL webhook
PUBLIC_BASE_URL=
# Port lokal untuk mengakses app dari mesin ini saja (127.0.0.1)
LOCAL_PORT=3000
# Landing page secretary.my.id (service `landing`): nomor WhatsApp untuk semua tombol "Chat",
# format 62xxx tanpa + atau spasi. Kosong = nomor bawaan Sekretaris AI di docker-compose.yml.
LANDING_WA_NUMBER=
LANDING_PORT=8080

# --- Umum -------------------------------------------------------------------
DEFAULT_TIMEZONE=Asia/Jakarta
LOG_LEVEL=info
# Token untuk /admin dan CLI. Minimal 24 karakter: openssl rand -hex 24
ADMIN_TOKEN=

# --- WhatsApp ---------------------------------------------------------------
# meta = WhatsApp Cloud API resmi · fonnte = gateway tidak resmi (POC, lihat docs/setup-fonnte.md)
WA_PROVIDER=meta
# true = tidak mengirim apa pun; balasan dicetak ke log dengan batasan kanal yang
# dipilih. Coba alur dengan `docker compose exec app node dist/cli.js say ...`
WA_DRY_RUN=true

# Fonnte
FONNTE_TOKEN=
# Bagian rahasia di URL webhook Fonnte (Fonnte tidak menandatangani webhook): openssl rand -hex 16
FONNTE_WEBHOOK_SECRET=
FONNTE_TYPING=true
# true bila paket Fonnte meneruskan lampiran (Super/Advanced/Ultra). Di paket Free,
# file dikirim lewat link unggah (ketik FILE di WhatsApp).
FONNTE_ATTACHMENTS=false
UPLOAD_MAX_MB=25
UPLOAD_LINK_HOURS=24

# Milo mengirim pesan ke orang lain setelah pengguna menekan Kirim (hanya Fonnte).
# off | admin (nomor di SERVER_ADMIN_NUMBERS) | all
MESSAGE_SEND_ACCESS=all
MESSAGE_SEND_DAILY_LIMIT=20
# Balasan penerima diteruskan ke pengguna selama sekian jam setelah pesan terkirim
RELAY_REPLY_HOURS=72

# WhatsApp Cloud API (WA_PROVIDER=meta)
# Dari Meta for Developers > WhatsApp > API Setup
WA_PHONE_NUMBER_ID=
# Token permanen dari System User (lihat docs/setup-meta.md)
WA_ACCESS_TOKEN=
# App settings > Basic > App secret. Dipakai memverifikasi tanda tangan webhook.
WA_APP_SECRET=
# Bebas, minimal 8 karakter; isi yang sama di kolom "Verify token" webhook Meta
WA_VERIFY_TOKEN=
WA_GRAPH_VERSION=v25.0
# Nama template utility yang sudah disetujui Meta, untuk pengingat di luar
# jendela 24 jam. Isi template harus punya satu variabel {{1}} (teks pengingat).
WA_REMINDER_TEMPLATE=
WA_TEMPLATE_LANG=id

# --- Model AI ---------------------------------------------------------------
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# Model cadangan bila MILO_MODELS kosong.
MILO_MODEL=claude-opus-5
# Pembagian pengguna antar model, "model:bobot" dipisah koma. Tiap pengguna mendapat
# satu model dan tetap di situ. Model yang API key-nya kosong dilewati otomatis.
# Contoh: claude-sonnet-5:1,deepseek-flash:1   (Sonnet 5 = asumsi rancangan harga)
MILO_MODELS=claude-opus-5:1,deepseek-flash:1
MILO_EFFORT=low
# default = fallback server-side saat model menolak (hanya Opus 5 / Fable 5)
MILO_FALLBACKS=default
MILO_MAX_STEPS=6
# Jeda menunggu pesan beruntun sebelum Milo menjawab (ms)
MILO_DEBOUNCE_MS=4000
# Bila jawaban belum siap setelah sekian ms, Milo mengirim "Sebentar ya…" (-1 = matikan)
MILO_SLOW_NOTICE_MS=8000

# --- Pencarian internet ---------------------------------------------------------
# SearXNG jalan sebagai container di docker-compose.yml; kosongkan untuk mematikan.
SEARXNG_URL=http://searxng:8080
# Kunci internal SearXNG: openssl rand -hex 24
SEARXNG_SECRET=
# Opsional, dipakai kalau SearXNG gagal atau kosong (tavily.com)
TAVILY_API_KEY=
# Baca halaman yang isinya digambar JavaScript (mis. marketplace) lewat r.jina.ai. Kunci opsional: tanpa kunci
# batasnya rendah dan dibagi bersama. false = matikan, sekaligus mematikan cek harga marketplace.
WEB_RENDER_FALLBACK=true
JINA_API_KEY=
MARKET_SEARCHES_PER_DAY=20

# Pencarian video. Kosongkan saja: tanpa kunci, pencarian lewat SearXNG milik sendiri (kategori video), yang
# memberi judul, durasi, dan tautan. Isi dengan API key YouTube Data API v3 hanya kalau ingin tambahan nama
# channel, tanggal, dan jumlah tayangan; kuota gratisnya cuma ~100 pencarian/hari untuk seluruh layanan.
YOUTUBE_API_KEY=
YOUTUBE_SEARCHES_PER_DAY=5
WEB_SEARCH_MAX_RESULTS=6
WEB_READ_MAX_CHARS=12000

# --- Google (Kalender, Gmail, Drive) -------------------------------------------
# Kosongkan untuk mematikan. Panduan: docs/setup-google.md. Butuh PUBLIC_BASE_URL tetap
# (domain sendiri) dan SERVER_KEY_SECRET untuk mengenkripsi token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opsional; default <PUBLIC_BASE_URL>/google/callback
GOOGLE_REDIRECT_URL=
# tasks & forms perlu Tasks API + Forms API aktif dan scope-nya terdaftar di Cloud Console
GOOGLE_SERVICES=calendar,gmail,drive,contacts,tasks,forms

# Notion (public integration di notion.so/my-integrations).
# Redirect URI yang didaftarkan: <PUBLIC_BASE_URL>/notion/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Tempat & navigasi. Tanpa API key, Milo memakai OpenStreetMap: gratis, tapi tanpa rating dan jam buka.
# Isi GOOGLE_MAPS_API_KEY (Places API New) untuk dapat rating/jam buka — ditagih per pencarian.
# auto = Google kalau ada key, OSM kalau tidak. off = matikan pencarian tempat (link navigasi tetap jalan).
PLACES_PROVIDER=auto
GOOGLE_MAPS_API_KEY=
PLACE_SEARCHES_PER_DAY=30
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# Izin "restricted": bebas dipakai selama aplikasi Google berstatus Testing, tapi butuh
# audit CASA bila dibuka untuk umum. false = Gmail hanya kirim, Drive hanya file buatan Milo.
GOOGLE_GMAIL_READ=true
GOOGLE_DRIVE_FULL=true

# --- Akses server (hanya-baca) -------------------------------------------------
# off = mati; admin = hanya nomor di SERVER_ADMIN_NUMBERS; all = semua pengguna bisa
# menghubungkan server mereka sendiri lewat chat. Lihat docs/setup-server.md.
SERVER_ACCESS=admin
# Menjalankan perintah di server pengguna (deploy, restart). Perintahnya selalu ditulis pengguna sendiri,
# dan tiap eksekusi menunggu tombol konfirmasi. off | admin | all
SERVER_ACTION_ACCESS=all
# Nomor operator, dipisah koma (08xx/62xx). Mereka juga melihat server di servers.json
# dan mesin tempat Milo berjalan.
SERVER_ADMIN_NUMBERS=
# Kunci enkripsi private key server pengguna (openssl rand -hex 32). Wajib untuk
# SERVER_ACCESS=all. Jangan diganti setelah dipakai: kunci lama tidak bisa dibuka lagi.
SERVER_KEY_SECRET=
USER_SERVER_LIMIT=3
# Di Docker, mesin tempat Milo berjalan otomatis bisa dicek lewat service dockerproxy.
# Isi kosong untuk mematikannya:
# DOCKER_PROXY_URL=
LOCAL_SERVER_NAME=server-milo

# --- Pesan suara (opsional, API kompatibel OpenAI; default Groq) -------------
STT_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3-turbo
STT_USD_PER_HOUR=0.04

# --- Pembayaran -------------------------------------------------------------
# bypass = QR uji, pembayaran dikonfirmasi otomatis setelah jeda di bawah
# instanpay = QRIS sungguhan lewat pay.instanlive.id
PAYMENT_MODE=bypass
# sk_test_… (sandbox) atau sk_live_…. Callback URL di dashboard: <alamat publik>/pay/webhook
INSTANPAY_API_KEY=
INSTANPAY_BASE_URL=https://pay.instanlive.id/api/v1
# Sandbox: tandai lunas otomatis setelah jeda ini (ms) lewat endpoint simulasi; -1 untuk mematikan
INSTANPAY_SANDBOX_AUTOPAY_MS=5000
# -1 untuk mematikan konfirmasi otomatis (konfirmasi manual lewat CLI `paid`)
PAYMENT_BYPASS_DELAY_MS=3000
PAYMENT_EXPIRY_MINUTES=30
PRICE_PROFESIONAL_IDR=500000
PRICE_PENDIRI_IDR=400000
GRACE_DAYS=3

# --- Masa coba & batas kewajaran -------------------------------------------
TRIAL_DAYS=14
TRIAL_NUDGE_DAY=11
QUOTA_TRIAL_TURNS=220
QUOTA_PAID_TURNS=600
