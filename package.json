{
  "name": "milo-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Milo — asisten pribadi via WhatsApp (POC)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --import ./test/setup-env.ts --test --test-concurrency=1 test/*.test.ts",
    "smoke": "tsx src/smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "fastify": "^5.12.5",
    "mammoth": "^1.12.3",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "ssh2": "^1.17.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/qrcode": "^1.5.6",
    "@types/ssh2": "^1.15.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
